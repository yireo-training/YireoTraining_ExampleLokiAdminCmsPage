<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <update handle="loki_admin_components_form"/>

    <head>
        <title>YireoTraining ExampleLokiAdminCmsPage Form</title>
    </head>

    <body>
        <referenceContainer name="content">
            <block
                name="loki_admin_cms_page.form"
                template="Loki_AdminComponents::form.phtml">
                <arguments>
                    <argument name="acl_resource" xsi:type="string">Magento_Cms::save</argument>
                    <argument name="save_acl_resource" xsi:type="string">Magento_Cms::save</argument>
                    <argument name="delete_acl_resource" xsi:type="string">Magento_Cms::page_delete</argument>
                    <argument name="provider" xsi:type="string">Magento\Cms\Api\PageRepositoryInterface</argument>
                    <argument name="provider_handler" xsi:type="string">repository</argument>
                    <argument name="resource_model" xsi:type="string">Magento\Cms\Model\ResourceModel\Page</argument>
                    <argument name="factory" xsi:type="string">Magento\Cms\Model\PageFactory</argument>
                    <argument name="index_url" xsi:type="string">loki_admin_cms_page/index/grid</argument>
                    <argument name="item_convertor" xsi:type="object">YireoTraining\ExampleLokiAdminCmsPage\Form\Item\PageItemConvertor</argument>
                    <argument name="item_validators" xsi:type="array">
                        <item name="plain_text" xsi:type="object">YireoTraining\ExampleLokiAdminCmsPage\Form\Item\PlainTextValidator</item>
                    </argument>
                    <argument name="fields" xsi:type="array">
                        <item name="content" xsi:type="array">
                            <item name="field_type" xsi:type="string">editor</item>
                        </item>
                        <item name="page_layout" xsi:type="array">
                            <item name="visible" xsi:type="boolean">false</item>
                        </item>
                        <item name="layout_update_xml" xsi:type="array">
                            <item name="visible" xsi:type="boolean">false</item>
                        </item>
                        <item name="custom_layout_update_xml" xsi:type="array">
                            <item name="visible" xsi:type="boolean">false</item>
                        </item>
                        <item name="custom_root_template" xsi:type="array">
                            <item name="visible" xsi:type="boolean">false</item>
                        </item>
                        <item name="custom_theme" xsi:type="array">
                            <item name="visible" xsi:type="boolean">false</item>
                        </item>
                        <item name="custom_theme_from" xsi:type="array">
                            <item name="visible" xsi:type="boolean">false</item>
                        </item>
                        <item name="custom_theme_to" xsi:type="array">
                            <item name="visible" xsi:type="boolean">false</item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
